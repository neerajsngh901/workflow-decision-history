type DecisionHistory {
    decisionId: ID
    decision: String
    userId: String
    caseId: String
    remarks: String
    dateTime: String
}

type Query {
    getDecisionHistory(
        caseId: String!
    ): [DecisionHistory]!
}

type Mutation {
    processDecisionHistory(
        decision: String!
        userId: String!
        caseId: String!
        remarks: String
    ): DecisionHistory!
}